# Feature 28: Sound Effect System (Visual Representation)
SOUND_EMITTERS = []

def play_sound_effect(x, y, type="click", intensity=1.0):
    SOUND_EMITTERS.append({
        'x': x, 'y': y, 'type': type,
        'radius': 0, 'max_radius': 30 * intensity,
        'speed': 2.0 * intensity, 'alpha': 1.0
    })

def update_sound_effects():
    global SOUND_EMITTERS
    new_emitters = []
    for sound in SOUND_EMITTERS:
        sound['radius'] += sound['speed']
        sound['alpha'] = 1.0 - (sound['radius'] / sound['max_radius'])
        if sound['radius'] < sound['max_radius']:
            new_emitters.append(sound)
    SOUND_EMITTERS = new_emitters

def draw_sound_effects():
    for sound in SOUND_EMITTERS:
        glPushMatrix()
        glTranslatef(sound['x'], sound['y'], 1.0)
        if sound['type'] == "click":
            glColor4f(0.0, 1.0, 1.0, sound['alpha'] * 0.5)
        elif sound['type'] == "explosion":
            glColor4f(1.0, 0.5, 0.0, sound['alpha'] * 0.7)
        else:
            glColor4f(1.0, 1.0, 1.0, sound['alpha'] * 0.3)
        draw_circle_outline(sound['radius'], 24, 0.0)
        glPopMatrix()

# Feature 29: Mini-map
MINIMAP_VISIBLE = True

def draw_minimap():
    if not MINIMAP_VISIBLE:
        return
        
    glMatrixMode(GL_PROJECTION)
    glPushMatrix()
    glLoadIdentity()
    gluOrtho2D(0, 300, 0, 300)
    glMatrixMode(GL_MODELVIEW)
    glPushMatrix()
    glLoadIdentity()
    
    # Background
    glColor4f(0.1, 0.1, 0.1, 0.7)
    glBegin(GL_QUADS)
    glVertex2f(10, 10)
    glVertex2f(290, 10)
    glVertex2f(290, 290)
    glVertex2f(10, 290)
    glEnd()
    
    # Border
    glColor3f(1.0, 1.0, 1.0)
    glBegin(GL_LINE_LOOP)
    glVertex2f(10, 10)
    glVertex2f(290, 10)
    glVertex2f(290, 290)
    glVertex2f(10, 290)
    glEnd()
    
    # Draw player
    scale = 280 / (GRID_LEN * 2)
    px = 150 + player_x * scale
    py = 150 + player_y * scale
    glColor3f(0.0, 0.0, 1.0)
    glBegin(GL_QUADS)
    glVertex2f(px-3, py-3)
    glVertex2f(px+3, py-3)
    glVertex2f(px+3, py+3)
    glVertex2f(px-3, py+3)
    glEnd()
    
    # Draw exit
    if GATES:
        gx, gy = _gate_center(GATES[0])
        gx = 150 + gx * scale
        gy = 150 + gy * scale
        glColor3f(0.0, 1.0, 0.0)
        glBegin(GL_QUADS)
        glVertex2f(gx-4, gy-4)
        glVertex2f(gx+4, gy-4)
        glVertex2f(gx+4, gy+4)
        glVertex2f(gx-4, gy+4)
        glEnd()
    
    glPopMatrix()
    glMatrixMode(GL_PROJECTION)
    glPopMatrix()
    glMatrixMode(GL_MODELVIEW)

