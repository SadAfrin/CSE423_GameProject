            })

def update_time_warp_zones():
    global TIME_WARP_ACTIVE, sec_left
    TIME_WARP_ACTIVE = False
    
    for zone in TIME_WARP_ZONES:
        if zone['cooldown'] > 0:
            zone['cooldown'] -= 1
            continue
            
        dist = math.sqrt((player_x - zone['x'])**2 + (player_y - zone['y'])**2)
        if dist < zone['radius']:
            TIME_WARP_ACTIVE = True
            sec_left += 0.2  # Time moves slower in warp zone
            zone['active'] = True
        else:
            zone['active'] = False

def draw_time_warp_zones():
