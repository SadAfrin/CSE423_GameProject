# Feature 24: Particle Effects
PARTICLES = []

def create_explosion(x, y, z, color=(1.0, 0.5, 0.0), count=20):
    for _ in range(count):
        angle = random.uniform(0, 2 * math.pi)
        speed = random.uniform(2, 8)
        size = random.uniform(2, 6)
        life = random.uniform(30, 60)
        PARTICLES.append([
            x, y, z,
            math.cos(angle) * speed, math.sin(angle) * speed, random.uniform(2, 6),
            color[0], color[1], color[2],
            size, life
        ])

def update_particles():
    global PARTICLES
    new_particles = []
    for p in PARTICLES:
        p[0] += p[3]  # x += vx
        p[1] += p[4]  # y += vy
        p[2] += p[5]  # z += vz
        p[5] -= 0.1   # gravity
        p[9] -= 1     # life decrease
        
        if p[9] > 0 and p[2] > 0:
            new_particles.append(p)
    PARTICLES = new_particles

def draw_particles():
    glBegin(GL_QUADS)
    for p in PARTICLES:
        alpha = p[9] / 60.0  # fade out
        glColor4f(p[6], p[7], p[8], alpha)
        size = p[9] / 10.0  # shrink over time
        glVertex3f(p[0]-size, p[1]-size, p[2])
        glVertex3f(p[0]+size, p[1]-size, p[2])
        glVertex3f(p[0]+size, p[1]+size, p[2])
        glVertex3f(p[0]-size, p[1]+size, p[2])
    glEnd()

