# Feature 6: Dynamic Weather System
WEATHER_CYCLE = 0
WEATHER_STATE = 0  # 0=clear, 1=rain, 2=fog
WEATHER_INTENSITY = 0.0
RAIN_PARTICLES = []
FOG_DENSITY = 0.0

def init_weather_system():
    global RAIN_PARTICLES, WEATHER_STATE
    RAIN_PARTICLES = []
    WEATHER_STATE = random.randint(0, 2)
    for _ in range(200):
        x = random.uniform(-GRID_LEN, GRID_LEN)
        y = random.uniform(-GRID_LEN, GRID_LEN)
        z = random.uniform(100, 400)
        RAIN_PARTICLES.append([x, y, z, random.uniform(5, 15)])

def update_weather():
    global WEATHER_CYCLE, WEATHER_INTENSITY, FOG_DENSITY, WEATHER_STATE
    
    WEATHER_CYCLE += 0.001
    if WEATHER_CYCLE > 1.0:
        WEATHER_CYCLE = 0
        WEATHER_STATE = random.randint(0, 2)
    
    # Smooth weather transitions
    target_intensity = 0.7 if WEATHER_STATE == 1 else 0.0
    target_fog = 0.6 if WEATHER_STATE == 2 else 0.1
    
    WEATHER_INTENSITY += (target_intensity - WEATHER_INTENSITY) * 0.01
    FOG_DENSITY += (target_fog - FOG_DENSITY) * 0.01
    
    # Update rain particles
    if WEATHER_STATE == 1 and WEATHER_INTENSITY > 0.3:
        for p in RAIN_PARTICLES:
            p[2] -= p[3] * (0.5 + WEATHER_INTENSITY)
            if p[2] < 0:
                p[0] = random.uniform(-GRID_LEN, GRID_LEN)
                p[1] = random.uniform(-GRID_LEN, GRID_LEN)
                p[2] = random.uniform(300, 500)

def draw_weather_effects():
    if WEATHER_STATE == 1 and WEATHER_INTENSITY > 0.3:  # Rain
        glColor4f(0.7, 0.7, 1.0, 0.6 * WEATHER_INTENSITY)
        glBegin(GL_LINES)
        for p in RAIN_PARTICLES:
            if random.random() < WEATHER_INTENSITY:
                glVertex3f(p[0], p[1], p[2])
                glVertex3f(p[0], p[1], p[2] - 20)
        glEnd()
    
    elif WEATHER_STATE == 2:  # Fog
        glFogf(GL_FOG_DENSITY, FOG_DENSITY)
        glClearColor(0.6, 0.6, 0.6, 1.0)

# Feature 7: Day/Night Cycle
TIME_OF_DAY = 0.5  # 0=midnight, 0.5=noon, 1=midnight
DAY_NIGHT_SPEED = 0.0005

def update_day_night_cycle():
    global TIME_OF_DAY
    TIME_OF_DAY = (TIME_OF_DAY + DAY_NIGHT_SPEED) % 1.0

def get_sky_color():
    # Calculate sky color based on time of day
    if TIME_OF_DAY < 0.25:  # Night to dawn
        t = TIME_OF_DAY * 4
        return (0.1, 0.1, 0.3 + t * 0.2)
    elif TIME_OF_DAY < 0.5:  # Dawn to day
        t = (TIME_OF_DAY - 0.25) * 4
        return (0.1 + t * 0.5, 0.1 + t * 0.5, 0.5 - t * 0.2)
    elif TIME_OF_DAY < 0.75:  # Day to dusk
        t = (TIME_OF_DAY - 0.5) * 4
        return (0.6 - t * 0.3, 0.6 - t * 0.3, 0.3 + t * 0.2)
    else:  # Dusk to night
        t = (TIME_OF_DAY - 0.75) * 4
        return (0.3 - t * 0.2, 0.3 - t * 0.2, 0.5 + t * 0.3)

